# Copie para .env e preencha. Sem as chaves do Firebase o app roda em MODO DEMONSTRAÇÃO
# (login simulado, acesso liberado e receitas de exemplo, sem custo de IA).

# Firebase › Configurações do projeto › Seus apps › Web. AUTH_DOMAIN = domínio do app (o nginx repassa /__/ ao Firebase)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=appnovidades.com.br
VITE_FIREBASE_PROJECT_ID=qchef
VITE_FIREBASE_APP_ID=

# Servidor de receitas (servidor/vps, na VPS como o webhook do Dieta Fácil):
VITE_API_URL=https://appnovidades.com.br/api/qchef

# Links da Kiwify
VITE_LINK_COMPRA=https://pay.kiwify.com.br/SEU-LINK
VITE_LINK_PRO=https://pay.kiwify.com.br/SEU-LINK-PRO
VITE_EMAIL_SUPORTE=contato@hubbioguia.com.br
VITE_WHATSAPP_SUPORTE=5585999999999
